      "claim": 4,
      "exact_contract": "For the paper's supercritical Gaussian covariance and Bernoulli mean-shift models, isolated eigenvalues fluctuate at n^-1/2, while the unspiked upper edge fluctuates at n^-2/3.",
      "independent_checker": {
        "all_steps_checked": true,
        "edge_location": 2.914213562373095,
        "eigenvalue_delta_derivative": 3.872983346207417,
        "exact_outlier_location": "15/4",
        "floating_outlier_location": 3.75,
        "outlier_edge_gap": 0.8357864376269051,
        "spike_map_derivative": "7/8"
      },
      "limitation": "The analytical bridge is specific to Gaussian bi-orthogonal invariance. It does not extend the paper's statement to arbitrary non-Gaussian matrices or threshold-critical spikes.",
      "machine_checked_derivation": [
        {
          "checked": true,
          "statement": "strength=2 > sqrt(c), so the outlier is isolated from the edge",
          "step": "supercritical separation"
        },
        {
          "checked": true,
          "statement": "The supercritical spiked-Wishart CLT gives sqrt(n)*(lambda_cov-g(ell))=O_p(1).",
          "step": "covariance outlier CLT"
        },
        {
          "checked": true,
          "statement": "Conditional on nonzero Bernoulli gamma, Gaussian noise is right orthogonally invariant, so gamma/||gamma|| is distributionally equivalent to the isotropic right direction in the additive CLT.",
          "step": "conditional right invariance"
        },
        {
          "checked": true,
          "statement": "||gamma||^2/n=p_hat=pi+O_p(n^-1/2), hence the conditional mean-spike strength is theta_n^2=theta^2+O_p(n^-1/2).",
          "step": "random Bernoulli norm"
        },
        {
          "checked": true,
          "statement": "The additive singular-value CLT plus smooth g and the Bernoulli norm expansion imply sqrt(n)*(lambda_mean-g(theta^2))=O_p(1).",
          "step": "mean outlier delta method"
        },
        {
          "checked": true,
          "statement": "The white-Wishart upper-edge law gives n^(2/3)*(lambda_edge-(1+sqrt(c))^2)=O_p(1).",
          "step": "spectral edge law"
        }
      ],
